{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorial-modelo-3d:manifest:2.0",
  "title": "Manifesto neutro de modelo 3D",
  "description": "Coordinates are metres; unit_scale_to_m records original native API units, never a second scale to apply. CLI validation also checks finite numbers, ordered bounds, duplicate ids, parent references, cycles and count consistency.",
  "type": "object",
  "required": ["schema_version", "source", "objects", "views", "materials", "warnings", "extraction"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "synthetic": {"type": "boolean"},
    "source": {
      "type": "object",
      "required": ["software", "version", "path", "units", "unit_scale_to_m"],
      "properties": {
        "software": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "units": {"const": "m"},
        "unit_scale_to_m": {"type": "number", "exclusiveMinimum": 0},
        "native_units": {"type": "string"}
      }
    },
    "objects": {"type": "array", "items": {"$ref": "#/$defs/modelObject"}},
    "views": {"type": "array", "items": {"type": "object"}},
    "materials": {"type": "array"},
    "warnings": {"type": "array"},
    "extraction": {
      "type": "object",
      "required": ["status", "capabilities", "limitations"],
      "properties": {
        "status": {"enum": ["complete", "partial"]},
        "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "object_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "point": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "bounds": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {"min": {"$ref": "#/$defs/point"}, "max": {"$ref": "#/$defs/point"}}
    },
    "modelObject": {
      "type": "object",
      "required": ["id", "name", "kind", "parent_id", "definition_id", "layer", "visible", "world_bounds_m", "materials", "properties"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "kind": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"]},
        "definition_id": {"type": ["string", "null"]},
        "layer": {"type": ["string", "null"]},
        "visible": {"type": "boolean"},
        "world_bounds_m": {"anyOf": [{"$ref": "#/$defs/bounds"}, {"type": "null"}]},
        "materials": {"type": "array"},
        "properties": {"type": "object"}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"extraction": {"properties": {"status": {"const": "complete"}}}}},
    "then": {"properties": {
      "objects": {"items": {"properties": {"world_bounds_m": {"$ref": "#/$defs/bounds"}}}},
      "extraction": {"properties": {
        "limitations": {"maxItems": 0},
        "capabilities": {"allOf": [
          {"contains": {"const": "objects"}}, {"contains": {"const": "hierarchy"}},
          {"contains": {"const": "world_bounds_m"}}, {"contains": {"const": "units"}}
        ]}
      }}
    }}
  }]
}
